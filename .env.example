# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM (Nebius Token Factory, Nemotron 3 Ultra) ---
NEBIUS_API_KEY=

# --- Web research (Agent Researcher) ---
TAVILY_API_KEY=

# --- GitHub (Agent Engineer) ---
# Option 1: GitHub App (used first if both values are set)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=secrets/autoheal-app.private-key.pem
# Or put the key directly on one line, with \n for line breaks:
# GITHUB_APP_PRIVATE_KEY=

# Option 2: Personal Access Token (fallback, for testing)
GITHUB_TOKEN=

# Demo repo used by the connection test (owner/name)
DEMO_REPO=

# --- Webhook (optional) ---
# If set, POST /webhook requires the header X-AutoHeal-Secret with this value.
# Add the same value as the AUTOHEAL_WEBHOOK_SECRET secret in the demo repo.
AUTOHEAL_WEBHOOK_SECRET=

# --- Frontend ---
BACKEND_URL=http://127.0.0.1:8000

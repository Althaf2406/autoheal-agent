# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM (Nebius Token Factory, Nemotron 3 Ultra) ---
NEBIUS_API_KEY=

# --- Web research (Agent Researcher) ---
TAVILY_API_KEY=

# --- GitHub (Agent Engineer) ---
# Option 1: GitHub App (used first if both values are set)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=secrets/autoheal-app.private-key.pem
# Or put the key directly on one line, with \n for line breaks:
# GITHUB_APP_PRIVATE_KEY=

# Option 2: Personal Access Token (fallback, for testing)
GITHUB_TOKEN=

# Demo repo used by the connection test (owner/name)
DEMO_REPO=

# --- Webhook (optional) ---
# If set, POST /webhook requires the header X-AutoHeal-Secret with this value.
# Add the same value as the AUTOHEAL_WEBHOOK_SECRET secret in the demo repo.
AUTOHEAL_WEBHOOK_SECRET=

# --- V2 guardrails, sandbox and rate limits (all optional, defaults shown) ---
# Sandbox for pytest: auto (Docker if installed, otherwise off) | docker | local (NOT isolated, dev only) | off
AUTOHEAL_SANDBOX=auto
# AUTOHEAL_SANDBOX_IMAGE=python:3.11-slim
# AUTOHEAL_SANDBOX_TIMEOUT=120
# AUTOHEAL_MAX_ITERATIONS=3
# AUTOHEAL_MAX_DIFF_LINES=80
# AUTOHEAL_MAX_FILES=3
# AUTOHEAL_MAX_PRS_PER_HOUR=3
# AUTOHEAL_FINGERPRINT_COOLDOWN=1800
# AUTOHEAL_BREAKER_THRESHOLD=3
# AUTOHEAL_BREAKER_RESET=3600
# Set to 0 to skip the semgrep layer (semgrep is optional and not in requirements.txt)
# AUTOHEAL_SEMGREP=1
# Escalation messages go here when set (Slack incoming webhook URL)
SLACK_WEBHOOK_URL=

# --- Frontend ---
BACKEND_URL=http://127.0.0.1:8000
